# RPHelper environment — copy to .env and fill in as needed. No real secrets here.
# Prod: docker-compose.prod.yml reads the repo-root .env (env_file).
# Dev: the backend reads backend/.env (resolved relative to the backend working directory).
# Every value below is optional; the commented value is the default. Ports are not settings.

# Directory holding the SQLite file and logs (relative to the backend working directory).
# RPHELPER_DATA_DIR=data
# SQLite file name inside the data directory.
# RPHELPER_DB_FILENAME=rphelper.sqlite
# Snowflake node id; give each separate instance its own.
# RPHELPER_NODE_ID=0
# Name of the HttpOnly session cookie.
# RPHELPER_SESSION_COOKIE_NAME=rphelper_session
# Session lifetime in hours.
# RPHELPER_SESSION_TTL_HOURS=720

# Timeout, in seconds, for every outbound LLM call.
# RPHELPER_LLM_REQUEST_TIMEOUT_SECONDS=30.0

# Console log sink threshold (stderr).
# RPHELPER_LOG_CONSOLE_LEVEL=DEBUG
# Rotating file log sink threshold.
# RPHELPER_LOG_FILE_LEVEL=WARNING
# Rotating file log path.
# RPHELPER_LOG_FILE_PATH=data/logs/rphelper.log
# Rotate the log file at this size.
# RPHELPER_LOG_FILE_ROTATION=10 MB
# Number of rotated log files to keep.
# RPHELPER_LOG_FILE_RETENTION=5

# Web search (optional). Deliberately unprefixed - these are existing variable names; do
# not rename them to RPHELPER_*. If either is missing or blank, web search is not offered.
# Google Custom Search API key.
SEARCH_CSE_KEY=
# Google custom search engine id (cx).
SEARCH_CSE_ID=

# LLM server API keys: an llm_servers API key stored as "$ENV_VAR" (e.g. "$OPENAI_API_KEY")
# resolves against this environment at call time, so the named variable belongs here too.
# OPENAI_API_KEY=
